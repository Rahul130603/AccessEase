# Razorpay dashboard credentials. Never put the secret in a client website.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Public deployment (configure these in cPanel's environment settings).
# COOKIE_SECURE=true
# PUBLIC_ORIGIN=https://app.example.com
# ADMIN_CREDENTIAL_FILE=/home/CPANEL_USER/accessease/.local/admin-auth.json
# PLATFORM_DATA_DIR=/home/CPANEL_USER/accessease-data
# Run one Node.js worker only. Default session expiry: 8 hours.
